// LuxLane — greenfield data model.
// Source of truth: brief §7.
//
// Conventions
//   - All ids are cuid().
//   - All timestamps are UTC, default now().
//   - Everything is tenant-scoped by Agency.
//   - Enums match the brief exactly; do not rename without updating the spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// Tenancy
// ───────────────────────────────────────────────────────────

model Agency {
  id                       String   @id @default(cuid())
  name                     String
  city                     String?
  country                  String?  @default("FR")
  signupCode               String   @unique
  logoUrl                  String?
  defaultCommissionPercent Float    @default(20)
  currency                 String   @default("EUR")
  // Operational cities — agencies with multiple offices (Paris + Milan, say)
  // surface a city filter on the board and roster. Empty means single-city.
  cities                   String[] @default([])
  // Agency legal + billing info (French SIRET, VAT, banking details for invoices).
  legalName                String?
  addressLine              String?
  postalCode               String?
  siret                    String?
  vatNumber                String?
  iban                     String?
  bic                      String?
  // Public website toggle — when true, /a/[signupCode] is reachable.
  publicSiteEnabled        Boolean  @default(false)
  // Stripe Connect placeholder (Tier 3 stub — stores the Connect account id when wired up).
  stripeAccountId          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Billing (Stripe subscription). Null until the owner starts a subscription.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?   // stripe status: active, trialing, past_due, canceled, …
  subscriptionPlan     String?   // "starter", "pro", "scale"
  trialEndsAt          DateTime?

  users          User[]
  members        AgencyMember[]
  models         Model[]
  jobs           Job[]
  broadcasts     Broadcast[]
  invites        AgencyInvite[]
  teamInvites    TeamInvite[]
  invoices       Invoice[]
  contracts      Contract[]
  prospects      Prospect[]
  clients        Client[]
  clientBriefs   ClientBrief[]
  castingEvents  CastingEvent[]
  packages       TalentPackage[]

  @@index([signupCode])
}

enum UserRole {
  AGENCY_STAFF
  MODEL
  CLIENT
  CREATIVE
  MEMBER
  LUXLANE_ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  phone        String?
  role         UserRole
  agencyId     String?
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency              Agency?              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyMembership    AgencyMember?
  model               Model?
  messagesSent        Message[]            @relation("MessagesSent")
  broadcastsSent      Broadcast[]          @relation("BroadcastsSent")
  jobsOwned           Job[]                @relation("JobsOwned")
  assignmentsProposed JobAssignment[]      @relation("AssignmentsProposed")
  filesUploaded       RoomFile[]           @relation("FilesUploaded")
  notifications       Notification[]
  conversationMembers ConversationMember[]
  packagesCreated     TalentPackage[]      @relation("PackagesCreated")
  clientProfile       ClientProfile?
  creativeProfile     CreativeProfile?
  memberProfile       MemberProfile?
  connectionsSent     Connection[]         @relation("ConnectionsFrom")
  connectionsReceived Connection[]         @relation("ConnectionsTo")
  groupEventsHosted   GroupEvent[]         @relation("GroupEventsHosted")
  groupEventMembers   GroupEventMember[]
  clientBriefs        ClientBrief[]        @relation("ClientBriefsAuthored")
  linkedAgencyClients Client[]             @relation("ClientPlatformUser")

  @@index([agencyId])
}

enum AgencyMemberRole {
  OWNER
  BOOKER
  PRODUCTION
  ACCOUNTS
}

model AgencyMember {
  userId      String           @id
  agencyId    String
  role        AgencyMemberRole
  permissions Json?
  createdAt   DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

// ───────────────────────────────────────────────────────────
// Models (the talent)
// ───────────────────────────────────────────────────────────

enum Division {
  WOMEN
  MEN
  CURVE
  KIDS
  TALENTS
  NEW_FACES
}

enum ModelStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ModelRepresentation {
  AGENCY_SIGNED
  INDEPENDENT
}

enum NetworkVisibility {
  HIDDEN
  AGENCY_ONLY
  OPEN
}

model Model {
  userId            String      @id
  agencyId          String
  division          Division              @default(WOMEN)
  status            ModelStatus           @default(ACTIVE)
  representation    ModelRepresentation   @default(AGENCY_SIGNED)
  networkVisibility NetworkVisibility     @default(AGENCY_ONLY)
  // Optional stage / professional name. When set, used on the Board, comp
  // card, public roster page. Legal name (User.displayName) is reserved for
  // contracts, invoices, payouts.
  stageName         String?
  // Measurements JSON: { heightCm, bustCm, waistCm, hipsCm, shoeEu, dressEu, suitEu, inseamCm, hair, eyes }
  measurements      Json?
  exclusions        String[]    @default([])
  commissionPercent Float?
  motherAgencyId    String?
  // Mother-agency referral — when another agency sent this model our way.
  // Name is a free-form string since most referring agencies aren't on
  // LuxLane. Commission is the % split we owe back on gross earnings.
  motherAgencyName              String?
  motherAgencyCommissionPercent Float?
  // City where the model is based out of, for multi-city agencies. Defaults
  // to the agency's primary city at signup.
  baseCity          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency           Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  documents        ModelDocument[]
  portfolio        PortfolioImage[]
  availability     Availability[]
  assignments      JobAssignment[]
  holds            Hold[]
  broadcastTargets BroadcastResponse[]
  packageItems     TalentPackageItem[]

  @@index([agencyId, status])
  @@index([agencyId, division])
}

enum DocumentType {
  PASSPORT
  VISA
  TAX_FORM
  CONTRACT
  RELEASE
  BANK_INFO
  OTHER
}

model ModelDocument {
  id         String       @id @default(cuid())
  modelId    String
  type       DocumentType
  fileUrl    String
  fileName   String
  expiresAt  DateTime?
  uploadedAt DateTime     @default(now())

  model Model @relation(fields: [modelId], references: [userId], onDelete: Cascade)

  @@index([modelId])
  @@index([expiresAt])
}

enum PortfolioKind {
  BOOK
  POLAROID
  VIDEO
}

model PortfolioImage {
  id        String        @id @default(cuid())
  modelId   String
  url       String
  kind      PortfolioKind @default(BOOK)
  order     Int           @default(0)
  caption   String?
  createdAt DateTime      @default(now())

  model Model @relation(fields: [modelId], references: [userId], onDelete: Cascade)

  @@index([modelId, kind, order])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  TRAVELING
}

model Availability {
  id      String             @id @default(cuid())
  modelId String
  date    DateTime           @db.Date
  status  AvailabilityStatus
  reason  String?

  model Model @relation(fields: [modelId], references: [userId], onDelete: Cascade)

  @@unique([modelId, date])
  @@index([modelId, date])
}

// ───────────────────────────────────────────────────────────
// Jobs & holds
// ───────────────────────────────────────────────────────────

enum JobType {
  EDITORIAL
  CAMPAIGN
  RUNWAY
  FITTING
  COMMERCIAL
  EVENT
  TEST
}

enum JobStatus {
  DRAFT
  OPEN
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum RateType {
  DAY
  FLAT
  HOURLY
}

model Job {
  id           String    @id @default(cuid())
  agencyId     String
  title        String
  type         JobType
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  location     String?
  locationCity String?
  brief        String?   @db.Text
  defaultRate  Float?
  currency     String    @default("EUR")
  rateType     RateType  @default(DAY)
  status       JobStatus @default(DRAFT)
  ownerUserId  String
  // Usage rights (scope of the talent licence sold to the client).
  // territory: "FR", "EU", "Worldwide", etc. media: printed array of
  // ["Print","Digital","OOH","Social","TV","PR"]. duration: human-readable
  // ("6 months", "1 year"). usageExpiresAt: computed cutoff for compliance.
  usageTerritory String?
  usageDuration  String?
  usageMedia     String[] @default([])
  usageExpiresAt DateTime?
  // Optional exclusivity category — if set, any overlapping confirmed job in
  // the same category for the same model raises a conflict alert
  // (e.g. "Perfume / LVMH", "Denim").
  exclusivityCategory String?
  // Optional link to a Client — powers the client portal. Client sees just
  // their own jobs. Nullable: job can stand alone without a client record.
  clientId     String?
  briefId      String?   @unique
  // Soft delete — rows live in Trash for 30 days before cron purges.
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agency      Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  owner       User            @relation("JobsOwned", fields: [ownerUserId], references: [id])
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourceBrief ClientBrief?    @relation(fields: [briefId], references: [id], onDelete: SetNull)
  contacts    JobContact[]
  assignments JobAssignment[]
  holds       Hold[]
  room        JobRoom?
  broadcasts  Broadcast[]
  travelItems TravelItem[]
  invoices    Invoice[]
  outfits     OutfitOption[]
  groupEvents GroupEvent[]

  @@index([agencyId, status])
  @@index([agencyId, startDate])
  @@index([agencyId, deletedAt])
}

enum JobContactRole {
  CLIENT
  BOOKER
  PRODUCER
  VENUE
  OTHER
}

model JobContact {
  id      String         @id @default(cuid())
  jobId   String
  name    String
  role    JobContactRole @default(CLIENT)
  company String?
  email   String?
  phone   String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

enum AssignmentStatus {
  PROPOSED
  OPTION_1
  OPTION_2
  OPTION_3
  CONFIRMED
  DECLINED
  RELEASED
  DONE
}

model JobAssignment {
  id               String           @id @default(cuid())
  jobId            String
  modelId          String
  status           AssignmentStatus @default(PROPOSED)
  rate             Float?
  rateType         RateType?
  notes            String?
  // Per-model call time + wrap time (HH:mm strings, model-local). Surface on
  // the Board so bookers see "7:00 → 16:00" alongside the option colour.
  callTime         String?
  wrapTime         String?
  // Model counter-offer — proposed from /m/jobs/[id]. Booker sees it on the
  // job page and either accepts (sets rate = modelProposedRate and clears
  // the counter) or rejects (clears the counter + pings the model).
  modelProposedRate Float?
  modelRateNote    String?
  // Callsheet confirmation — stamped when the model taps "I've read this"
  // on the latest callsheet attached to the job.
  callsheetReadAt  DateTime?
  // Day-of check-in — stamped when the model taps "I'm on set" on shoot day.
  checkedInAt      DateTime?
  // Client portal review: the client can approve / flag each proposed model.
  // Booker sees the stamp + optional note on the agency side. NULL = pending.
  clientReaction   ClientReactionType?
  clientReactionAt DateTime?
  clientReactionNote String?
  proposedByUserId String
  proposedAt       DateTime         @default(now())
  confirmedAt      DateTime?
  declinedAt       DateTime?

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  model      Model @relation(fields: [modelId], references: [userId], onDelete: Cascade)
  proposedBy User  @relation("AssignmentsProposed", fields: [proposedByUserId], references: [id])

  @@unique([jobId, modelId])
  @@index([jobId])
  @@index([modelId, status])
}

// Denormalized per-date-per-model hold — populated from JobAssignments.
// This is what the Board queries against for fast lookups.
enum HoldPriority {
  P1
  P2
  P3
  CONFIRMED
}

enum HoldStatus {
  HELD
  CONFIRMED
  RELEASED
}

model Hold {
  id       String       @id @default(cuid())
  modelId  String
  jobId    String
  date     DateTime     @db.Date
  priority HoldPriority
  status   HoldStatus   @default(HELD)

  model Model @relation(fields: [modelId], references: [userId], onDelete: Cascade)
  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([modelId, date, jobId])
  @@index([modelId, date])
  @@index([jobId, date])
}

// ───────────────────────────────────────────────────────────
// Job rooms (chat + files + schedule, per job)
// ───────────────────────────────────────────────────────────

model JobRoom {
  id        String   @id @default(cuid())
  jobId     String   @unique
  createdAt DateTime @default(now())

  job      Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages Message[]
  files    RoomFile[]
  schedule RoomScheduleItem[]
}

model Message {
  id                   String   @id @default(cuid())
  roomId               String?
  directConversationId String?
  senderUserId         String
  body                 String   @db.Text
  attachmentUrl        String?
  createdAt            DateTime @default(now())

  room               JobRoom?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  directConversation DirectConversation? @relation(fields: [directConversationId], references: [id], onDelete: Cascade)
  sender             User                @relation("MessagesSent", fields: [senderUserId], references: [id])

  @@index([roomId, createdAt])
  @@index([directConversationId, createdAt])
}

enum RoomFileType {
  CALLSHEET
  BRIEF
  LOOKBOOK
  CONTRACT
  OTHER
}

model RoomFile {
  id               String       @id @default(cuid())
  roomId           String
  name             String
  type             RoomFileType @default(OTHER)
  url              String
  uploadedByUserId String
  createdAt        DateTime     @default(now())

  room       JobRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("FilesUploaded", fields: [uploadedByUserId], references: [id])

  @@index([roomId])
}

model RoomScheduleItem {
  id       String   @id @default(cuid())
  roomId   String
  title    String
  date     DateTime @db.Date
  time     String?
  location String?
  notes    String?

  room JobRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, date])
}

// ───────────────────────────────────────────────────────────
// Direct 1:1 conversations (agency staff ↔ model)
// ───────────────────────────────────────────────────────────

model DirectConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

// ───────────────────────────────────────────────────────────
// Broadcasts — "any of you free Mar 10–12?"
// ───────────────────────────────────────────────────────────

model Broadcast {
  id           String   @id @default(cuid())
  agencyId     String
  senderUserId String
  body         String   @db.Text
  jobId        String?
  createdAt    DateTime @default(now())

  agency    Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  sender    User                @relation("BroadcastsSent", fields: [senderUserId], references: [id])
  job       Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  responses BroadcastResponse[]

  @@index([agencyId, createdAt])
}

enum BroadcastResponseValue {
  ACCEPT
  DECLINE
  NO_RESPONSE
}

model BroadcastResponse {
  id          String                 @id @default(cuid())
  broadcastId String
  modelId     String
  response    BroadcastResponseValue @default(NO_RESPONSE)
  respondedAt DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  model     Model     @relation(fields: [modelId], references: [userId], onDelete: Cascade)

  @@unique([broadcastId, modelId])
  @@index([modelId])
}

// ───────────────────────────────────────────────────────────
// Notifications & invites
// ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model AgencyInvite {
  id               String    @id @default(cuid())
  agencyId         String
  token            String    @unique
  email            String?
  expiresAt        DateTime?
  consumedByUserId String?
  createdAt        DateTime  @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

// Password reset — issued when a user hits /forgot-password, one-time use,
// ~1 hour lifetime. Multiple outstanding per user are OK (we just consume
// the first used one and cron-clean the rest).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────────────────────────────────────────
// Tier 2/3 — Team, Travel, Invoices, Contracts, Prospects
// ───────────────────────────────────────────────────────────

// Team member invite (agency staff). Consumed at signup to bypass the
// model signup code and drop the user straight into AgencyMember.
model TeamInvite {
  id         String           @id @default(cuid())
  agencyId   String
  email      String
  role       AgencyMemberRole @default(BOOKER)
  token      String           @unique
  expiresAt  DateTime?
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([email])
}

// Travel items attached to a job. Surfaced in the job room and in the
// model's schedule. Model is optional — e.g. a shared hotel applies to
// everyone on the job.
enum TravelType {
  FLIGHT
  TRAIN
  HOTEL
  TRANSFER
  CAR
  OTHER
}

model TravelItem {
  id           String     @id @default(cuid())
  jobId        String
  modelId      String?
  type         TravelType
  title        String
  description  String?    @db.Text
  fromLocation String?
  toLocation   String?
  startAt      DateTime?
  endAt        DateTime?
  reference    String?
  createdAt    DateTime   @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([modelId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  agencyId        String
  jobId           String?
  number          String
  issuedAt        DateTime      @default(now())
  dueAt           DateTime?
  clientName      String
  clientCompany   String?
  clientAddress   String?       @db.Text
  clientVatNumber String?
  subtotal        Float
  taxRate         Float         @default(20)
  taxAmount       Float
  total           Float
  currency        String        @default("EUR")
  status          InvoiceStatus @default(DRAFT)
  sentAt          DateTime?
  paidAt          DateTime?
  notes           String?       @db.Text
  deletedAt       DateTime?
  deletedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  agency    Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  job       Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]

  @@unique([agencyId, number])
  @@index([agencyId, status])
  @@index([jobId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float
  modelId     String?
  // Per-line tax override (NULL = inherit Invoice.taxRate). Allows mixing
  // domestic 20% TVA with 0% / reduced lines on the same invoice.
  taxRate     Float?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum ContractKind {
  MODEL_AGENCY
  BOOKING
  CLIENT
  OTHER
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  CANCELLED
}

model Contract {
  id         String         @id @default(cuid())
  agencyId   String
  title      String
  kind       ContractKind
  fileUrl    String?
  modelId    String?
  jobId      String?
  status     ContractStatus @default(DRAFT)
  sentAt     DateTime?
  signedAt   DateTime?
  signedName String?
  signedIp   String?
  sigToken   String?        @unique
  sigTokenExpiresAt DateTime?
  notes       String?       @db.Text
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([modelId])
  @@index([jobId])
}

enum ProspectStatus {
  NEW
  CONTACTED
  MEETING_BOOKED
  SIGNED
  REJECTED
}

model Prospect {
  id              String         @id @default(cuid())
  agencyId        String
  name            String
  email           String?
  phone           String?
  instagramHandle String?
  city            String?
  notes           String?        @db.Text
  source          String?
  status          ProspectStatus @default(NEW)
  imageUrl        String?
  createdByUserId String
  convertedUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
}

// Activity log — append-only audit trail scoped to an agency.
model AuditEvent {
  id         String   @id @default(cuid())
  agencyId   String
  actorId    String
  actorName  String
  action     String
  entityType String
  entityId   String
  summary    String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([entityType, entityId])
}

// Model payouts — record of what each model was paid (or is owed) per job.
// Generated when an invoice is marked PAID or manually from a job's "settle"
// action. Model-side /m/earnings reads this.
enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

model ModelPayout {
  id          String       @id @default(cuid())
  agencyId    String
  modelId     String
  jobId       String?
  invoiceId   String?
  gross       Float
  commission  Float
  net         Float
  currency    String       @default("EUR")
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  stripeTransferId String?
  note        String?
  createdAt   DateTime     @default(now())

  @@index([agencyId, status])
  @@index([modelId, status])
  @@index([jobId])
}

// ───────────────────────────────────────────────────────────
// Tier A/B additions — look boards, measurement history
// ───────────────────────────────────────────────────────────

// Point-in-time snapshot of a Model.measurements JSON. Written whenever an
// agency staff member overwrites measurements so the history is preserved
// (models grow / lose weight / season to season changes matter on comp cards).
model MeasurementSnapshot {
  id            String   @id @default(cuid())
  modelId       String
  measurements  Json
  takenByUserId String
  takenAt       DateTime @default(now())

  @@index([modelId, takenAt])
}

// Look board — outfits uploaded by the stylist/booker for a job. Each model
// on the job can react (APPROVE / FLAG) with an optional note. Keeps the
// fitting conversation on-platform instead of WhatsApp DMs.
model OutfitOption {
  id        String   @id @default(cuid())
  jobId     String
  title     String
  imageUrl  String
  notes     String?  @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reactions OutfitReaction[]

  @@index([jobId, order])
}

enum OutfitReactionType {
  APPROVE
  FLAG
}

model OutfitReaction {
  id        String             @id @default(cuid())
  optionId  String
  modelId   String
  reaction  OutfitReactionType
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  option OutfitOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, modelId])
  @@index([modelId])
}

// ───────────────────────────────────────────────────────────
// Client portal — external clients (brands, magazines) get a
// magic-link view of their jobs + the proposed lineup.
// ───────────────────────────────────────────────────────────

enum ClientReactionType {
  APPROVE
  FLAG
}

model Client {
  id                  String        @id @default(cuid())
  agencyId            String
  name                String
  companyName         String?
  email               String
  phone               String?
  subtype             ClientSubtype @default(BRAND)
  // Magic-link token — sent by email. Rotates on revoke. Consumed setter
  // lands a cookie scoped to /client/[id].
  portalToken         String?   @unique
  portalTokenIssuedAt DateTime?
  portalEnabled       Boolean   @default(false)
  platformUserId      String?   @unique
  createdByUserId     String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  platformUser User?         @relation("ClientPlatformUser", fields: [platformUserId], references: [id], onDelete: SetNull)
  jobs         Job[]
  briefs       ClientBrief[]

  @@index([agencyId])
  @@index([email])
}

// ───────────────────────────────────────────────────────────
// Talent packages — shareable portfolio links for clients
// (Frava-style packages with view analytics).
// ───────────────────────────────────────────────────────────

model TalentPackage {
  id              String    @id @default(cuid())
  agencyId        String
  title           String
  token           String    @unique
  note            String?   @db.Text
  passwordHash    String?
  expiresAt       DateTime?
  createdByUserId String
  lastEmailedAt   DateTime?
  emailRecipients String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency  Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator User                @relation("PackagesCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  items   TalentPackageItem[]
  views   TalentPackageView[]

  @@index([agencyId, createdAt])
}

model TalentPackageItem {
  id          String @id @default(cuid())
  packageId   String
  modelId     String
  sortOrder   Int    @default(0)
  heroImageId String?

  package TalentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  model   Model         @relation(fields: [modelId], references: [userId], onDelete: Cascade)

  @@unique([packageId, modelId])
  @@index([packageId, sortOrder])
}

model TalentPackageView {
  id         String   @id @default(cuid())
  packageId  String
  viewedAt   DateTime @default(now())
  viewerHint String?

  package TalentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, viewedAt])
}

// ───────────────────────────────────────────────────────────
// Casting events — time-slotted castings where prospects /
// models book a slot through a public link.
// ───────────────────────────────────────────────────────────

model CastingEvent {
  id              String    @id @default(cuid())
  agencyId        String
  title           String
  description     String?   @db.Text
  location        String?
  date            DateTime  @db.Date
  slotMinutes     Int       @default(15)
  slotsPerWindow  Int       @default(1)
  startTime       String    @default("10:00") // HH:mm
  endTime         String    @default("18:00") // HH:mm
  // Public booking code — combined with a slug path.
  code            String    @unique
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  slots  CastingSlot[]

  @@index([agencyId, date])
}

model CastingSlot {
  id           String       @id @default(cuid())
  eventId      String
  startAt      DateTime
  // Booked-by identity — we capture name + contact for walk-ins even when
  // the person hasn't signed up as a model yet. prospectId links to an
  // existing Prospect record when available.
  bookedName   String?
  bookedEmail  String?
  bookedPhone  String?
  bookedAt     DateTime?
  prospectId   String?
  notes        String?      @db.Text

  event CastingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, startAt])
  @@index([eventId, startAt])
}

// ───────────────────────────────────────────────────────────
// Platform accounts — clients, creatives, members (network)
// ───────────────────────────────────────────────────────────

enum ClientSubtype {
  BRAND
  MEDIA_AGENCY
  PRODUCTION
  MAGAZINE
  ECOMMERCE
  CASTING_DIRECTOR
  PHOTOGRAPHER
  DESIGNER
  PR_EVENTS
  TV_FILM
  OTHER
}

enum BriefStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  DECLINED
  CONVERTED
}

model ClientBrief {
  id              String      @id @default(cuid())
  authorUserId    String
  targetAgencyId  String
  agencyClientId  String?
  title           String
  description     String?     @db.Text
  location        String?
  city            String?
  startDate       DateTime?   @db.Date
  endDate         DateTime?   @db.Date
  status          BriefStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  author       User    @relation("ClientBriefsAuthored", fields: [authorUserId], references: [id], onDelete: Cascade)
  agency       Agency  @relation(fields: [targetAgencyId], references: [id], onDelete: Cascade)
  agencyClient Client? @relation(fields: [agencyClientId], references: [id], onDelete: SetNull)
  convertedJob Job?

  @@index([authorUserId, status])
  @@index([targetAgencyId, status])
}

model ClientProfile {
  userId      String        @id
  subtype     ClientSubtype @default(BRAND)
  companyName String?
  city        String?
  country     String?       @default("FR")
  bio         String?       @db.Text
  websiteUrl  String?
  avatarUrl   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CreativeSubtype {
  PHOTOGRAPHER
  STYLIST
  MUA
  HAIR
  SET_DESIGN
  OTHER
}

model CreativeProfile {
  userId      String          @id
  subtype     CreativeSubtype @default(PHOTOGRAPHER)
  city        String?
  country     String?         @default("FR")
  bio         String?         @db.Text
  portfolioUrl String?
  avatarUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MemberProfile {
  userId    String   @id
  city      String?
  bio       String?  @db.Text
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Connection {
  id          String           @id @default(cuid())
  fromUserId  String
  toUserId    String
  status      ConnectionStatus @default(PENDING)
  message     String?          @db.Text
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  fromUser User @relation("ConnectionsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionsTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

enum GroupEventType {
  CASTING
  SHOOT
  FITTING
  SHOW
  MEETING
  COLLAB
  OTHER
}

enum GroupEventStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

model GroupEvent {
  id          String           @id @default(cuid())
  hostUserId  String
  type        GroupEventType   @default(COLLAB)
  status      GroupEventStatus @default(DRAFT)
  title       String
  description String?          @db.Text
  location    String?
  city        String?
  startDate   DateTime         @db.Date
  endDate     DateTime?        @db.Date
  rolesNeeded Json?
  linkedJobId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  host        User               @relation("GroupEventsHosted", fields: [hostUserId], references: [id], onDelete: Cascade)
  linkedJob   Job?               @relation(fields: [linkedJobId], references: [id], onDelete: SetNull)
  members     GroupEventMember[]

  @@index([hostUserId, status])
  @@index([startDate])
  @@index([linkedJobId])
}

enum GroupEventMemberRole {
  HOST
  MODEL
  MUA
  STYLIST
  PHOTOGRAPHER
  CLIENT
  OTHER
}

enum GroupEventMemberStatus {
  INVITED
  APPLIED
  ACCEPTED
  DECLINED
}

model GroupEventMember {
  id        String                 @id @default(cuid())
  eventId   String
  userId    String
  role      GroupEventMemberRole   @default(OTHER)
  status    GroupEventMemberStatus @default(INVITED)
  note      String?                @db.Text
  createdAt DateTime               @default(now())

  event GroupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}
